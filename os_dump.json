  "/os/src/ui/ai.css": ".ai{--ai1:#8b6bff;--ai2:#ff5fae;--ai3:#ffb84d;--ai4:#5fe1ff;position:relative;display:flex;height:100%;color:#eceaf5;font-family:var(--ui);background:#0f0e17;isolation:isolate;overflow:hidden}.ai-aura{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden}.ai-aura i{position:absolute;border-radius:50%;opacity:.5}.ai-aura i:nth-child(1){width:70%;height:60%;left:35%;top:-30%;background:radial-gradient(closest-side,rgb(139 107 255 / .35),transparent)}.ai-aura i:nth-child(2){width:50%;height:50%;left:70%;top:-10%;background:radial-gradient(closest-side,rgb(255 95 174 / .22),transparent)}.ai-orb{position:relative;display:grid;place-items:center;flex:none;width:28px;height:28px;border-radius:50%;overflow:hidden;background:radial-gradient(circle at 70% 25%,var(--ai2),transparent 55%),radial-gradient(circle at 25% 80%,var(--ai3),transparent 50%),radial-gradient(circle at 20% 30%,var(--ai4),transparent 40%),radial-gradient(circle at 50% 42%,#9d7dff,#5b33e6 55%,#2a1385);box-shadow:inset 0 0 0 1px #ffffff47,0 4px 16px #8b6bff66}.ai-orb-swirl{position:absolute;inset:-30%;background:conic-gradient(from 0deg,transparent,rgb(255 255 255 / .22),transparent 30%,rgb(255 95 174 / .25),transparent 60%,rgb(95 225 255 / .2),transparent);mix-blend-mode:overlay;animation:ai-spin 9s linear infinite}.ai-star{position:relative;width:58%;height:58%;fill:#fff;filter:drop-shadow(0 0 3px rgb(255 255 255 / .7))}@keyframes ai-spin{to{transform:rotate(360deg)}}.ai-orb.sm{width:24px;height:24px}.ai-orb.av{width:30px;height:30px;margin-top:-2px}.ai-orb.spin .ai-orb-swirl{animation-duration:1.4s}.ai-orb.spin{animation:ai-breathe 1.4s ease-in-out infinite}@keyframes ai-breathe{50%{transform:scale(1.1);box-shadow:inset 0 0 0 1px #ffffff59,0 4px 26px #8b6bffbf}}.ai-orb.big{width:84px;height:84px;box-shadow:inset 0 0 0 1px #ffffff4d,0 18px 60px #8b6bff8c,0 0 120px #ff5fae2e;animation:ob-pop .8s var(--spring-bouncy,var(--ease-out)) backwards,ai-float 5s ease-in-out